{
  "compileOnSave": true,
  "compilerOptions": {
    /* TypeScript 6 defaults "types" to [] rather than every package under typeRoots. */
    "types": ["node"],
    /* TypeScript 6 requires rootDir to be explicit alongside outDir (TS5011). */
    /* Must be ./src/lib, matching "include" below: outDir is dist/lib and package.json
      main is dist/lib/index.js, so src/lib/index.ts has to land at dist/lib/index.js.
      A rootDir of ./ emits dist/lib/src/lib/index.js and the package entry point 404s. */
    "rootDir": "./src/lib",
    /* TS 6 reports moduleResolution:node as deprecated (TS5107); still functional through 6.x. */
    "ignoreDeprecations": "6.0",
    "alwaysStrict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "commonjs",
    "moduleResolution": "Node",
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "pretty": true,
    "removeComments": true,
    "strict": true,
    /* Raised from ES2015: the dotAll (/s) flag used in read-jest-puppeteer-config.ts
       requires es2018 or later (TS1501). TypeScript 5.5 added regular-expression syntax
       checking, so this was never reported by the previous compiler. */
    "target": "ES2018",
    "outDir": "dist/lib",
    "declaration": true
  },
  "include": [
    "src/lib/**/*"
  ],
  "exclude": [
    "node_modules/"
  ]
}
